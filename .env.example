# Copy this file to .env and replace only the credential for your selected provider.
OPENAI_API_KEY=replace-with-openai-api-key
XAI_API_KEY=replace-with-xai-api-key
GEMINI_API_KEY=replace-with-gemini-api-key

# Optional defaults. Command-line flags take precedence.
CIRCUITPILOT_PROVIDER=gemini
CIRCUITPILOT_MODEL=gemini-3.8-flash
